{
  "name": "thunder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.node.json && node scripts/copy-schema.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "package": "pnpm build && electron-builder",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "verify:hashes": "tsx scripts/verify-hashes.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "check-disk-space": "3.4.0",
    "electron-log": "5.4.4",
    "micromatch": "4.0.8",
    "node-llama-cpp": "3.22.3",
    "systeminformation": "5.27.11",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@secretlint/core": "8.3.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/micromatch": "4.0.9",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitejs/plugin-react": "4.3.4",
    "@monaco-editor/react": "4.6.0",
    "monaco-editor": "0.52.2",
    "electron": "32.2.7",
    "electron-builder": "25.1.8",
    "eslint": "9.17.0",
    "playwright": "1.49.1",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8",
    "zustand": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "electron", "node-llama-cpp"]
  }
}
